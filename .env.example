# ── Waitlist form backend ─────────────────────────────────────────────────────
# These are inlined into the built JS at build time and are therefore PUBLIC.
# They are NOT secrets. The token only deters casual abuse; real spam defense is
# the hidden honeypot field + server-side validation in apps-script/Code.gs.
#
# Copy this file to `.env` and fill in the values after deploying the Apps Script
# (see apps-script/README.md for the 5-minute setup).

# The Google Apps Script Web App /exec URL that appends submissions to your Sheet.
VITE_WAITLIST_ENDPOINT=

# A shared string; must match the TOKEN script property set in the Apps Script.
VITE_WAITLIST_TOKEN=asnd-waitlist
